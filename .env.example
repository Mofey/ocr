# Set on the Vercel worker project. Use the EXACT existing CMD value.
# At least 32 random UTF-8 bytes. Never copy this value to Main or the sandbox.
OCR_WORKER_GRANT_SECRET=

# Printed by npm run prepare:snapshot; the snapshot contains code/models ONLY.
OCR_SANDBOX_SNAPSHOT_ID=

# Optional. Keep one fixed slot per Vercel project to enforce one job at a time.
OCR_SANDBOX_SLOT=ledgerical-ocr-active

# Optional; use the same region when preparing and consuming the snapshot.
OCR_SANDBOX_REGION=iad1

# Vercel supplies OIDC automatically in production. For local preparation:
# npx vercel login; npx vercel link; npx vercel env pull .env.local
# env pull creates .env.local with VERCEL_OIDC_TOKEN. Do not create an empty file.
# No database, R2, Main, CMD, AI-provider or signing credentials go in a sandbox.
